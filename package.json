{
  "name": "icims-ai-voice-demo",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "tunnel": "tsx scripts/tunnel.ts",
    "setup:twilio": "tsx scripts/setup-twilio.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@twilio/voice-sdk": "^2.19.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.75.0",
    "openai": "^7.59.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "twilio": "^6.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
