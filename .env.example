# --- Twilio ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Needed by the setup script and for X-Twilio-Signature validation.
TWILIO_AUTH_TOKEN=
# Access Token signing. Leave blank and `npm run setup:twilio` will create them.
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Filled in by `npm run setup:twilio`.
TWILIO_TWIML_APP_SID=
# Set to false only for local debugging.
TWILIO_VALIDATE_SIGNATURES=true

# --- Public URL -------------------------------------------------------------
# The ngrok https URL. `npm run setup:twilio` detects it from a running ngrok.
PUBLIC_BASE_URL=

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# --- ConversationRelay tuning (DECISIONS.md, Decisions 5–8) -------------------
CR_SPEECH_TIMEOUT_MS=900
CR_EOT_THRESHOLD=0.7
CR_IGNORE_BACKCHANNEL=false
CR_ECHO_PROMPT_FILTERING=false
# Optional voice override. Blank = ConversationRelay default (ElevenLabs Flash, low latency).
CR_TTS_PROVIDER=
CR_VOICE=

# --- Server -------------------------------------------------------------------
PORT=3001
MAX_CALL_SECONDS=300
